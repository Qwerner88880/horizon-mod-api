From: hui <vlado.kerando@gmail.com>
Date: Thu, 29 Oct 2026 03:24:33 +0100
Subject: [PATCH 12/43] Wake the friends deadline test on Windows

The test read from the socket while the deadline's thread raced to shut
it down: on Windows a read already blocked stays blocked through another
thread's shutdown (it sat there for two minutes and failed), where a
read begun afterwards sees the end as any platform does. Wait out the
deadline first; what the test proves is unchanged - the deadline's
stream reads to its end, the dropped one's does not.

Co-Authored-By: ZCode AI agent (GLM-5.3)
---
 crates/horizon-friends/src/lib.rs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/crates/horizon-friends/src/lib.rs b/crates/horizon-friends/src/lib.rs
index 0a0c2d10c..eb0be3ccd 100644
--- a/crates/horizon-friends/src/lib.rs
+++ b/crates/horizon-friends/src/lib.rs
@@ -176,6 +176,12 @@ mod tests {
         let (mut ended, _) = l.accept().unwrap();
         drop(deadline(&kept, Duration::from_millis(100)).unwrap());
         let _running = deadline(&ended, Duration::from_millis(100)).unwrap();
+        // Read after the deadline has fired, not while it races the read:
+        // Windows never wakes a read that is already blocked when another
+        // thread shuts the socket down, while a read begun afterwards sees
+        // the end as any platform does.
+        std::thread::sleep(Duration::from_millis(200));
+        ended.set_read_timeout(Some(Duration::from_secs(2))).unwrap();
         let started = Instant::now();
         assert_eq!(ended.read(&mut [0u8; 1]).unwrap(), 0);
         assert!(started.elapsed() < Duration::from_secs(2));
