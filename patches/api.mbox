From f16de7d317d8e08098ce1cca1dfbf389eb79c001 Mon Sep 17 00:00:00 2001
From: hui <vlado.kerando@gmail.com>
Date: Thu, 29 Oct 2026 03:56:33 +0100
Subject: [PATCH 13/43] Reconnect the host's relay port on Windows

A host session through a relay connects from the host's own direct port,
so the relay's guests see the address they can reach. When the next
session reconnects from that port soon after the last one ended, Windows
silently drops the SYNs - the four-tuple still sits in TIME_WAIT - and
the connect times out, where the port being taken shows up as an error
the fallback to an ephemeral port already covers. Treat a timeout the
same way: the address may say what it saw either way, and a session that
must not fail comes first. This is what kept a second relayed session
from joining for two minutes after the first one ended.

Co-Authored-By: ZCode AI agent (GLM-5.3)
---
 crates/horizon-friends/src/direct.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/crates/horizon-friends/src/direct.rs b/crates/horizon-friends/src/direct.rs
index 7c80822d5..d6c943a4c 100644
--- a/crates/horizon-friends/src/direct.rs
+++ b/crates/horizon-friends/src/direct.rs
@@ -74,9 +74,15 @@ pub fn connect_from(port: Option<u16>, to: SocketAddr, timeout: Duration) -> io:
         {
             match s.connect_timeout(&SockAddr::from(to), timeout) {
                 Ok(()) => return Ok(s.into()),
+                // The port may be unusable: taken, or - on Windows - its
+                // four-tuple with this address still in TIME_WAIT from an
+                // earlier session, whose dropped SYNs show up as a timeout.
+                // Any other failure is the address's own; try without the
+                // port, as the bind failing above does.
                 Err(e)
                     if e.kind() != io::ErrorKind::AddrInUse
-                        && e.kind() != io::ErrorKind::AddrNotAvailable =>
+                        && e.kind() != io::ErrorKind::AddrNotAvailable
+                        && e.kind() != io::ErrorKind::TimedOut =>
                 {
                     return Err(e);
                 }
