+            },
+            Entry {
+                key: "name".into(),
+                description: "What it is called.".into(),
+                spec: Spec::Text("Sentinel".into()),
+            },
+            Entry {
+                key: "sound".into(),
+                description: "Which chime.".into(),
+                spec: Spec::Choice {
+                    default: "chime".into(),
+                    options: vec!["chime".into(), "bell".into()],
+                },
+            },
