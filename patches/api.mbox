+/// A grid name is a saved-data key: one path segment of `[a-z0-9_.-]{1,64}`,
+/// not `.` or `..`.
+fn grid_name_ok(name: &str) -> bool {
+    let chars_ok = (1..=64).contains(&name.len())
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"_.-".contains(&b));
+    chars_ok && name != "." && name != ".."
