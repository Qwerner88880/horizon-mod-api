+        "music" => 1,
+        "record" => 2,
+        "weather" => 3,
+        "block" => 4,
+        "hostile" => 5,
+        "neutral" => 6,
+        "player" => 7,
+        "ambient" => 8,
+        "voice" => 9,
+        _ => return None,
+    })
