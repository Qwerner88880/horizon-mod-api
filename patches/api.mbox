+fn effect_name_ok(name: &str) -> bool {
+    let plain = |t: &str| {
+        !t.is_empty()
+            && t.len() <= 96
+            && t.bytes()
+                .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"_.-/".contains(&b))
+    };
+    match name.split_once(':') {
+        Some((ns, path)) => plain(ns) && plain(path),
+        None => plain(name),
+    }
