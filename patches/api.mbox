+        assert!(c.set("charge", &Value::Number(5.0)).is_err());
+        assert!(c.set("nothing", &Value::Integer(1)).is_err());
+        assert!(c.set("sound", &Value::Text("gong".into())).is_err());
+        let file = c.set("sound", &Value::Text("bell".into())).unwrap();
