+/// a byte-array component; the harness needs no full item syntax.
+fn data_of(components: &str, mod_id: &str) -> Vec<u8> {
+    let key = format!("horizon:{mod_id}=");
+    components
+        .split(',')
+        .find_map(|part| {
+            let bytes = part.strip_prefix(&key)?;
+            Some(
+                bytes
+                    .split('.')
+                    .filter(|b| !b.is_empty())
+                    .filter_map(|b| b.parse().ok())
+                    .collect::<Vec<u8>>(),
+            )
+        })
+        .unwrap_or_default()
+}
