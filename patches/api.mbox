+        self.out.push(Output::ShowDisplay {
+            mod_id: self.id.clone(),
+            name,
+            dimension,
+            pos: [x, y, z],
+            shape,
+            transform,
+            interpolation: interpolation.min(1200),
+        });
+        Ok(())
+    }
+    fn hide(&mut self, name: String) {
+        self.out.push(Output::HideDisplay {
+            mod_id: self.id.clone(),
+            name,
+        });
+    }
