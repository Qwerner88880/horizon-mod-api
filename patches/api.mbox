+                log::warn!(
+                    "Horizon: a mod sent particle {}, which is not one it can",
+                    p.name
+                );
+                return None;
+            };
+            let rgb = |c: u32| {
+                [
+                    ((c >> 16) & 255) as f32 / 255.0,
+                    ((c >> 8) & 255) as f32 / 255.0,
+                    (c & 255) as f32 / 255.0,
+                ]
+            };
