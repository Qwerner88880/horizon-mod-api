+        )])
+        .of_mod("m")
+        .first()
+        .cloned()
+        .unwrap();
+        assert_eq!(s.anchor, [0, 0, 0]);
+        assert_eq!(
+            s.cells,
+            [Cell {
+                dx: 0,
+                dy: 0,
+                dz: 0,
+                blocks: vec!["minecraft:stone".into()],
+            }]
+        );
+        // A space and "air" name a cell that must be empty; a list holds
+        // the blocks, any of which fits.
+        let s = build(&[(
+            "m:s".into(),
+            r####"{"palette": {"#": ["minecraft:stone", "minecraft:iron_block"], ".": "air"},
+                "layers": [["# ", " #"]]}"####
+                .into(),
+        )])
+        .of_mod("m")
+        .first()
